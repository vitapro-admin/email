{
  "name": "aquapro-email",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "mail:up": "docker compose -f infra/docker-compose.yml up -d",
    "mail:down": "docker compose -f infra/docker-compose.yml down",
    "mail:seed": "pnpm --filter @aquapro/infra seed",
    "test:integration": "MAIL_TEST_IMAP_HOST=127.0.0.1 TEST_DATABASE_URL=postgres://aquapro:aquapro-dev@127.0.0.1:5432/aquapro pnpm test",
    "gallery": "pnpm --filter @aquapro/email-render gallery",
    "dev:api": "DATABASE_URL=postgres://aquapro:aquapro-dev@127.0.0.1:5432/aquapro pnpm --filter @aquapro/api dev",
    "admin:demo": "DATABASE_URL=postgres://aquapro:aquapro-dev@127.0.0.1:5432/aquapro pnpm --filter @aquapro/directory admin demo",
    "dev:web": "pnpm --filter @aquapro/web dev",
    "e2e": "pnpm --filter @aquapro/web e2e",
    "crm:mock": "pnpm --filter @aquapro/crm-connector mock",
    "db:migrate": "DATABASE_URL=postgres://aquapro:aquapro-dev@127.0.0.1:5432/aquapro pnpm --filter @aquapro/db migrate",
    "crm:sync": "pnpm --filter @aquapro/crm-sync sync",
    "crm:demo": "DATABASE_URL=postgres://aquapro:aquapro-dev@127.0.0.1:5432/aquapro pnpm --filter @aquapro/crm-sync demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
